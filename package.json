{
  "name": "ctf-worker",
  "version": "0.1.0",
  "description": "Autonomous CTF challenge dispatcher: watches a challenge source, stages challenges, hands them to a Pi agent, classifies outcomes, and forces continuation until solved or fatally blocked.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/database/schema.sql dist/database/schema.sql",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "once": "tsx src/index.ts --once",
    "scan": "tsx src/index.ts --scan",
    "cli": "node dist/cli.js",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^12.4.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
