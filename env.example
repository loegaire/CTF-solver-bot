# ctf-worker environment file — copy to /etc/ctf-worker/env
# All values optional unless noted. See README.md for full reference.

# ---- source -------------------------------------------------------------
# github | local
SOURCE=github
# "owner/name" (required when SOURCE=github)
GITHUB_REPO=
# GitHub PAT with repo read access — strongly recommended (rate limits)
GITHUB_TOKEN=
GITHUB_BRANCH=main
# Challenge root directory inside the repo
GITHUB_CHALLENGES_PREFIX=challenges
# Local source dir (when SOURCE=local)
LOCAL_SOURCE_DIR=

# ---- discovery ----------------------------------------------------------
POLL_INTERVAL_SEC=120
# Webhook receiver (best-effort accelerator for polling)
WEBHOOK_ENABLED=true
WEBHOOK_PORT=4567
WEBHOOK_HOST=127.0.0.1
# Shared secret for GitHub HMAC signatures; empty disables verification
WEBHOOK_SECRET=

# ---- state --------------------------------------------------------------
DB_PATH=/var/lib/ctf-worker/ctf-worker.db
JOBS_DIR=/var/lib/ctf-worker/jobs

# ---- job control --------------------------------------------------------
MAX_CONCURRENT=1
MAX_ATTEMPTS=20
# Rotation system: minutes per challenge turn before rotating to the next.
# WRITEUP is captured and the queue moves on; resumes after a full round.
TURN_MINUTES=10
RUN_TIMEOUT_MIN=120
IDLE_TIMEOUT_MIN=10
KILL_GRACE_SEC=15

# ---- agent --------------------------------------------------------------
# pi | echo (echo = deterministic fake for testing)
AGENT_BACKEND=pi
PI_BIN=pi
# Extra args appended to every pi invocation (e.g. "--provider openai --model gpt-4o")
PI_EXTRA_ARGS=

# ---- reporting ----------------------------------------------------------
STATUS_INTERVAL_SEC=60
# Discord webhook URL; empty = log-only output
DISCORD_WEBHOOK_URL=

# ---- discord bot (/status command + SOLVED announcements) ----------------
# When enabled, the dispatcher runs the bot in-process: /status dumps the DB,
# and every SOLVED challenge is announced with an @everyone ping.
DISCORD_BOT_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Channel for SOLVED announcements. Empty = auto-detect: prefers a channel
# named "solved", then "announcements", "general", then the first text channel.
DISCORD_ANNOUNCE_CHANNEL_ID=

LOG_LEVEL=info
